# Copy to .env. Secrets are read only from this file, never the shell environment.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1004472119156
BALE_CHANNEL_ID=5716375015

# Telegram and jev; leave blank for direct access. Bale always connects directly.
TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808

# Directions used by run. Legacy *_ENABLED names remain accepted.
TG_TO_BALE=false
BALE_TO_TG=false
# Health remains read-only. Set false to let inspect-echo publish its test posts.
DRY_RUN=true

DATABASE_PATH=data/channel-sync.sqlite3
REPORTS_DIR=reports
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
POLL_TIMEOUT_SECONDS=10
RETRY_ATTEMPTS=3
RETRY_BASE_SECONDS=1
SIGNATURE_TTL_SECONDS=600
CIRCUIT_WINDOW_SECONDS=60
CIRCUIT_MAX_SENDS=20
ALBUM_WAIT_SECONDS=3

# Classify Telegram discussion comments as soon as the existing poller receives them.
# Bale channel comments have no documented bot delivery and moderation is a no-op.
MODERATION_ENABLED=true
# TypeSafe secret: read only from this .env file. Required for classification.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Only should_delete decides deletion, including equality at the threshold.
MODERATION_THRESHOLD=0.55
# Optional alerts for REVIEW_LOW <= should_delete < THRESHOLD; DRY_RUN sends none.
MODERATION_REVIEW_LOW=0.45
MODERATION_CHANNEL_TOPIC=Technology news and tutorials
# Negative Telegram group ID; blank discovers getChat(channel).linked_chat_id.
# Add the Telegram bot there as admin with the Delete messages right.
TELEGRAM_DISCUSSION_GROUP_ID=
# Reserved for future documented Bale comment support; currently ignored.
BALE_DISCUSSION_GROUP_ID=
MODERATION_SKIP_ADMINS=true
# Optional Telegram chat ID for English review alerts (bot must be able to send).
MODERATION_ALERT_CHAT_ID=

# AI news curator. Enable after configuring both admin lists, LLM and MCP search.
CURATOR_ENABLED=false
X_BROWSER_PROFILE_DIR=data/x-profile
# Blank inherits TELEGRAM_PROXY_URL. Chrome SOCKS proxies cannot use credentials.
X_PROXY_URL=
X_TIMEZONE=Asia/Tehran
X_ACTIVE_HOURS=09:00-23:30
X_MAX_POSTS_PER_DAY=400
X_SESSION_MINUTES_MIN=10
X_SESSION_MINUTES_MAX=25
X_BREAK_MINUTES_MIN=30
X_BREAK_MINUTES_MAX=90
# Watchdog kills only the browser process tree above this summed RSS budget; 0 disables it.
X_BROWSER_MEMORY_MB=1536
X_BROWSER_WATCHDOG_SECONDS=90
CURATOR_RELEVANCE_THRESHOLD=0.7
TOPIC_DEDUP_DAYS=30
TOPIC_DEDUP_CANDIDATES=8
TOPIC_SAME_THRESHOLD=0.8
# API base including /v1 when your provider requires it. Must support chat tool calling.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOOL_ROUNDS=8
# Routes only LLM HTTP through TELEGRAM_PROXY_URL. Bale stays direct.
LLM_USE_PROXY=false
# Independently routes MCP HTTP (remote DNS) and stdio proxy env through TELEGRAM_PROXY_URL.
MCP_USE_PROXY=false
ADMIN_TELEGRAM_USER_IDS=
ADMIN_BALE_USER_IDS=
CHANNEL_SIGNATURE='🆔 @asrgooyeshpardaz'
MCP_SERVERS_PATH=mcp_servers.json
CURATOR_EXAMPLES_DIR=curator/examples
# Example MCP references; fill only those used by your chosen server.
EXA_API_KEY=
SEARCH_MCP_URL=
SEARCH_MCP_API_KEY=
SEARCH_MCP_COMMAND=
SEARCH_API_KEY=
